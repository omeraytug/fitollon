# Copy to backend/.env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Postgres. Locally: the docker-compose database. On Vercel: the Neon connection string (use the pooled one).
DATABASE_URL=postgresql://fitollon:fitollon@localhost:5433/fitollon

# Web app login (single user) and the key that signs the login cookie.
APP_PASSWORD=change-me
SESSION_SECRET=generate-with: uv run python -m fitollon.cli secret
# Local http://localhost needs false; keep true (the default) on Vercel.
COOKIE_SECURE=false

# Health Auto Export sends this as "Authorization: Bearer <token>".
INGEST_TOKEN=generate-with: uv run python -m fitollon.cli secret

# Your timezone (IANA name), used to decide what "today" is.
TIMEZONE=UTC

# AI model. MODEL_PROVIDER is "openai" or "anthropic".
MODEL_PROVIDER=openai
# For OpenAI, pick one from: uv run python -m fitollon.cli models
MODEL_ID=
OPENAI_API_KEY=
# Optional extra request parameters as JSON, e.g. {"reasoning": {"effort": "medium"}}
# MODEL_PARAMS={}
# ANTHROPIC_API_KEY=
